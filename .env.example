# Telos Brain deploy credentials and brain environment variables. Copy to `.env`
# and fill in.
#
# The .env file is loaded automatically by the CLI when it deploys this schema,
# so `npm run deploy` is self-contained and runs unchanged in CI. Real
# environment variables always take precedence over values in this file, so a
# CI secret overrides a checked-out .env.
#
# TELOS_* variables are CLI/deploy configuration and are consumed locally — they
# are NEVER uploaded to the brain. Every OTHER variable declared below is
# uploaded on deploy (POST /brains/{instance}/environment-variables) and stored
# encrypted at rest against the brain. Leave a line blank or omit it to skip it.

# --- CLI / deploy configuration (never uploaded) ---

# Organisation API key — the non-interactive deploy credential. It authenticates
# as the organisation directly (no person / Clerk sign-in required), so it is
# what CI/CD uses. Mint one as an organisation admin (in the Telos Brain app, or
# POST /organisations/current/api-keys); the full key is shown only once.
TELOS_BRAIN_ORG_API_KEY=tbk_replace_me

# Management API base URL. Defaults to http://localhost:5183 when unset.
TELOS_BRAIN_API_URL=https://go.telosbrain.com

# --- Brain environment variables (uploaded, encrypted at rest) ---

# LLM provider API keys. The model resolver maps a workflow's `model` prefix
# onto the conventional key name (e.g. `anthropic/claude-sonnet-4-6` ->
# ANTHROPIC_API_KEY, `openai/gpt-4o` -> OPENAI_API_KEY, `xai/grok-4.5` ->
# XAI_API_KEY). Starter workflows pin Anthropic, so ANTHROPIC_API_KEY is enough
# when no brain default is set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Local model runners — Ollama / llama.cpp (optional). Add one numbered entry
# per runner. The number maps to `local_{N}` in workflow model strings
# (e.g. `local_1/qwen3:8b`, `local_2/gemma4:e4b`). Presence of
# LOCAL_LLM_N_BASE_URL is the gate — if it is unset, that runner cannot be used.
# A trailing `/v1` is accepted and stripped; the conversant calls
# `{base}/v1/chat/completions`. From Brain-in-Docker, use host.docker.internal
# (not localhost) to reach a runner on the host (BRA106 §8).

# Ollama (Dockerised Brain connecting to the host):
# LOCAL_LLM_1_BASE_URL=http://host.docker.internal:11434/v1

# Ollama (native install, Brain running natively):
# LOCAL_LLM_1_BASE_URL=http://localhost:11434/v1

# llama.cpp server:
# LOCAL_LLM_1_BASE_URL=http://localhost:8080/v1

# Second runner (optional):
# LOCAL_LLM_2_BASE_URL=http://host.docker.internal:11435/v1

# Optional API key for secured local runners:
# LOCAL_LLM_1_API_KEY=your_optional_key_here

# Optional default LLM (provider/model). When set and the matching credential
# exists, every live run uses this model instead of the workflow frontmatter.
# Same role as Settings "Default LLM model" and brain-compose.yml `llm-model`.
# Leave blank to use each workflow's own `model:` (starter pins Anthropic).
# If that is also omitted, the run fails — leftover ANTHROPIC_API_KEY /
# OPENAI_API_KEY / XAI_API_KEY are not used as a silent default.
# Examples:
#   DEFAULT_LLM_MODEL=local_1/qwen3:8b
#   DEFAULT_LLM_MODEL=anthropic/claude-sonnet-4-6
DEFAULT_LLM_MODEL=

# Voyage — embedding provider for semantic search (find_available_skills,
# search_blueprint_entries, skill embeddings). Required when embedding-model is
# voyage-* (this brain defaults to voyage-3-lite). There is no server-level
# embedding key — each brain supplies its own here. A local LLM does not
# replace this key.
VOYAGE_API_KEY=

# Optional IANA timezone id used by {{now.local*}} template tags
# (e.g. Pacific/Auckland). When unset or unrecognised, local time falls back to UTC.
TIMEZONE=

# Optional brain Execution API key. Mint one for this brain instance and paste
# it here when an api tool needs to call this brain's own Execution API
# (inject via secret: BRAIN_API_KEY + header: Authorization). Not required for
# system tools such as create_inbox_entry.
BRAIN_API_KEY=

# Any other secret a declared api tool needs. Reference it from the tool with
# secret: <NAME> (and optionally header: / value: "Bearer {secret}").
# ACME_API_KEY=

# My App (connectors/my-app.yml + tools/execution/my-app — BRA209 / BRA202).
# MY_APP_API_URL — connector url-env (HTTPS in production; for Brain-in-Docker
# calling a harness on the host use http://host.docker.internal:<port>).
# MY_APP_API_KEY — injected by example_api_tool as Authorization: Bearer {secret}.
MY_APP_API_URL=http://host.docker.internal:5283
MY_APP_API_KEY=
